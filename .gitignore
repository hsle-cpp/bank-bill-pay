# Repo-wide ignores. Stack-specific rules live in frontend/.gitignore
# and backend/.gitignore.

# --- OS -------------------------------------------------------------
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors / IDEs -------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code (shared workspace config is allowed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Eclipse / Spring Tool Suite
.project
.classpath
.settings/
.factorypath
.apt_generated/
.apt_generated_tests/
.springBeans
.sts4-cache/

# NetBeans
nbproject/private/
nbbuild/
nbdist/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#

# Claude Code personal settings
.claude/settings.local.json

# --- Environment and secrets ----------------------------------------
# Commit a .env.example with placeholder values instead.
.env
.env.*
!.env.example
*.pem

# --- Logs -----------------------------------------------------------
logs/
*.log

# --- Docker / local PostgreSQL + pgAdmin ----------------------------
docker-compose.override.yml
postgres-data/
pgadmin-data/
*.dump
*.backup

# --- Local test data ------------------------------------------------
# Real bank statements must never be committed. Keep them here.
uploads/
local-data/
