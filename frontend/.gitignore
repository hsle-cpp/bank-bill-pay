# Expo / React Native Web frontend.
# Lockfiles (package-lock.json, bun.lock) are committed on purpose.

# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects produced by `expo prebuild` (the app is web-only)
/ios
/android
.kotlin/

# Native signing material
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Metro / bundler caches
.metro-health-check*
.cache/

# TypeScript
*.tsbuildinfo

# Tests (vitest)
coverage/

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.*

# Local env files
.env*.local
